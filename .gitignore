# Installed libraries and build output (re-created with npm install / npm run build)
node_modules/
dist/
build/
coverage/
.turbo/
.firebase/
playwright-report/
test-results/
*.tsbuildinfo

# Gabriela's decision (5 November 2026): everything else is kept in this public repository,
# including current-app/data.json, audit.json and .qsmart-key, docs/patent/ and the notes in notes/.
# New v2 secrets (.env: database and Firebase keys) stay local, because they will protect clients' data.
.env
.env.*
!.env.example

# Temporary files the app writes for a moment while saving
data.json.tmp
sandbox.json.tmp

# System files
*.log
.DS_Store
Thumbs.db

# Local lists that stay on this PC (for example the people invited into the demo)
*.local.txt
